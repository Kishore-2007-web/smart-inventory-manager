# ==========================================
# FridgeWise AI — Environment Configuration
# ==========================================

# Server Port
PORT=3001

# AI Integration Mode 1: Local AI (Ollama / LM Studio)
# Works completely offline on your local machine!
# Run: ollama run llama3 (or mistral, qwen2.5, gemma2)
LOCAL_AI_ENDPOINT=http://localhost:11434
LOCAL_AI_MODEL=llama3

# AI Integration Mode 2: Remote Google Gemini API (Optional)
# If set, used when Local AI daemon is not running
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional — Demo mode runs 100% offline without Firebase)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
